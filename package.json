{
  "name": "pear-drops",
  "productName": "Pear Drops",
  "version": "0.1.20",
  "description": "Desktop farmer for Kick emote and badge drops",
  "license": "GPL-3.0-only",
  "main": "src/main/main.js",
  "updateRepo": "StreamOrchard/pear-drops",
  "formerUpdateRepos": [
    "Stream-Orchard/pear-drops"
  ],
  "private": true,
  "scripts": {
    "start": "node scripts/harden.js && electron .",
    "dev": "node scripts/dev.js",
    "demo": "node scripts/dev.js --demo",
    "harden": "node scripts/harden.js",
    "test": "node --test --test-force-exit --test-timeout=60000 \"test/unit/**/*.test.js\"",
    "test:launch": "node --test --test-force-exit --test-concurrency=1 --test-timeout=120000 \"test/launch/**/*.test.js\"",
    "test:all": "npm test && npm run test:launch",
    "test:coverage": "node scripts/coverage.js",
    "icon": "electron scripts/make-icon/main.js",
    "dist:mac": "npx --yes electron-builder@26.15.3 --mac --publish never",
    "dist:win": "npx --yes electron-builder@26.15.3 --win --publish never",
    "test:launch:visible": "PD_TEST_VISIBLE=1 node --test --test-force-exit --test-concurrency=1 --test-timeout=120000 \"test/launch/**/*.test.js\"",
    "worktree": "node scripts/worktree.js",
    "signing-cert": "node scripts/mac-signing-cert.js",
    "grapevine:check": "grapevine-check"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.8.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.streamorchard.peardrops",
    "productName": "Pear Drops",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "CHANGELOG.md",
      "!src/**/*.md"
    ],
    "afterPack": "build/after-pack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Pear-Drops-${version}-mac.${ext}",
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "afterSign": "build/after-sign.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pear Drops",
      "runAfterFinish": true,
      "artifactName": "Pear-Drops-Setup-${version}.${ext}"
    },
    "publish": null
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@streamorchard/grapevine": "^0.10.2"
  },
  "grapevine": {
    "app": "com.streamorchard.peardrops",
    "provides": {
      "drops.farming": "1.0",
      "rewards.daily": "1.0"
    },
    "uses": {
      "players": "1.0"
    }
  }
}
